# Applies game and Workshop updates only when nobody is online (2 empty checks in a row),
# after a backup, with rollback. Install as root, then:
#   systemctl daemon-reload && systemctl enable --now deadbolt-update
# Do not add NoNewPrivileges=: dbolt uses sudo (narrow sudoers rule).
[Unit]
Description=Deadbolt update watcher for Project Zomboid
After=network-online.target pz.service

[Service]
User=dbolt
WorkingDirectory=/var/lib/deadbolt
ExecStart=/usr/local/bin/dbolt update watch -interval 10m
Restart=on-failure
RestartSec=30
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
